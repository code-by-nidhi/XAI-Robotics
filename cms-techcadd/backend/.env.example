# Copy to .env and fill in. The API validates all of this at boot and exits
# with a clear message rather than failing on the first request.

NODE_ENV=development
PORT=4000

# Where the CMS runs, and the website. Comma-separated: Vite falls back to
# 5174/5175 when 5173 is taken, and the website's browser code posts the
# contact form, applications and the page-view beacon straight to this API.
# The first entry is also the CMS address used in alert and reset emails.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# --- database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Quote it. A '#' outside quotes starts a comment, which silently truncates
# the password and produces a confusing access-denied error.
DB_PASSWORD=
DB_NAME=xai_content

# --- sessions ---------------------------------------------------------------
# At least 16 characters. Changing it signs everyone out.
COOKIE_SECRET=replace-with-a-long-random-string
SESSION_DAYS=7

# The second password in front of enquiries. Required in production (at least
# 8 characters); development falls back to a fixed, non-secret value.
ENQUIRIES_LOCK_PASSWORD=

# Sign-in attempts per IP per 15 minutes. Unset means 10 in production and
# 200 in development, where the only thing it throttles is you.
# LOGIN_ATTEMPTS_PER_15_MIN=10

# --- files ------------------------------------------------------------------
# Public media library, served at /uploads.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Job applicants' CVs. Never served; downloaded through the CMS only. Keep it
# outside UPLOAD_DIR and on a persistent volume.
PRIVATE_DIR=private

# --- first administrator (npm run db:seed) ----------------------------------
# Without SEED_PASSWORD a random password is generated and printed once.
# SEED_EMAIL=admin@example.com
# SEED_USERNAME=admin
# SEED_NAME=XAI Admin
# SEED_PASSWORD=

# --- email (optional) -------------------------------------------------------
# Without SMTP_HOST the CMS still runs and mail is logged to the console
# instead of sent — password resets and enquiry/application alerts alike.
# Where alerts go is set in the CMS: Settings → Email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=XAI Robotics CMS <no-reply@example.com>

# Where to tell the website that content changed. Optional: without these the
# site picks changes up when its own cache expires instead of immediately.
SITE_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=generate-a-long-random-string

# Sent on every response as X-CMS-Site, so the website can refuse an answer
# from a different CMS on a shared network. Defaults to xai.
CMS_SITE=xai
