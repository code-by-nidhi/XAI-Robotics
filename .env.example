# The XAI Robotics CMS API (cms-techcadd/backend). Copy to .env.local.

# Where the visitor's browser posts the contact form and the page-view beacon.
# Must be reachable from the browser, and this site's origin must be listed in
# the CMS's CORS_ORIGIN. Inlined at build time: rebuild after changing it.
NEXT_PUBLIC_CMS_API_URL=http://localhost:4000/api

# Where the Next.js server reads content (FAQs, settings). Optional; defaults
# to NEXT_PUBLIC_CMS_API_URL. Set it when the server reaches the CMS on an
# internal address, e.g. http://cms-backend:4000/api.
# CMS_API_URL=

# Must equal the CMS's CMS_SITE. Answers from any other CMS are ignored.
CMS_SITE=xai

# Must equal the CMS's REVALIDATE_SECRET. The CMS calls /api/revalidate with it
# after every save, so edits show at once instead of within 5 minutes.
REVALIDATE_SECRET=
